# Supply chain hardening — see doc/SUPPLY_CHAIN_HARDENING.md

# Prevent postinstall / preinstall scripts from executing arbitrary code.
# This is the primary mitigation against Mini Shai-Hulud-style attacks.
ignore-scripts=true

# Force exact versions when adding new packages (no ^ or ~ added automatically).
save-exact=true

# Always run audit after install so regressions are surfaced immediately.
audit=true

# Silence funding messages in CI logs.
fund=false

# Pin the registry — any package that cannot be resolved here fails loudly,
# preventing dependency-confusion attacks against private package names.
registry=https://registry.npmjs.org/
