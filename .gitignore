# ── Rust ────────────────────────────────────────────
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# ── Secrets / Environment variables ─────────────────
.env
.env.local
.env.*.local

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
*.venv
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── DuckDB ──────────────────────────────────────────
*.db
*.db.wal
*.mmdb
docker/data/*
!docker/data/db/
docker/data/db/*
!docker/data/db/.gitkeep

# ── macOS ────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverrideAttribute

# ── IDE ──────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Node / Frontend ──────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnp.*
*.tsbuildinfo

# ── Docker ───────────────────────────────────────────
docker/logs/*
!docker/logs/.gitkeep
# Compressed archives — but keep test fixtures
*.gz
!ingester/tests/testdata/*.gz

# ── Frontend build output ─────────────────────────────
# Vite outputs JS/CSS bundles to config_viz/static/assets/ — exclude them
# but keep the placeholder index.html
config_viz/static/assets/

# ── Coverage / test reports ──────────────────────────
coverage.xml
*.lcov
.coverage.*

# MkDocs documentation site build output
/website/site/
